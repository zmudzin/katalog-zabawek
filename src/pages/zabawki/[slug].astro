---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getStatusConfig, getCategoryLabel } from '../../utils/status';
import toysData from '../../data/toys.json';

export async function getStaticPaths() {
  return toysData.map((toy) => ({
    params: { slug: toy.slug },
    props: { toy },
  }));
}

const { toy } = Astro.props;
const statusConfig = getStatusConfig(toy.status);
const mainImage = toy.images[0] || { src: '/placeholder.webp', alt: toy.name };

// Pre-filled mailto link
const emailSubject = encodeURIComponent(`Pytanie o: ${toy.name}`);
const emailBody = encodeURIComponent(
  `Dzień dobry,\n\nChciał(a)bym zapytać o zabawkę "${toy.name}" (https://zabawki.losia3.xyz/zabawki/${toy.slug}).\n\nMoje pytanie: `
);
const mailtoHref = `mailto:kontakt@losia3.xyz?subject=${emailSubject}&body=${emailBody}`;
---

<Layout
  title={`${toy.name} — Rękodzielniczy Katalog Zabawek`}
  description={toy.shortDescription}
  image={mainImage.src}
  ogType="product"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
    <!-- Breadcrumb / Back button -->
    <nav class="mb-6">
      <a
        href="/#katalog"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-craft-muted hover:text-craft-accent transition-colors group"
      >
        <span class="w-7 h-7 rounded-full bg-white border border-[#E5E0D8] flex items-center justify-center group-hover:border-craft-accent transition-colors">
          <Icon name="arrow-left" class="w-3.5 h-3.5" />
        </span>
        <span>Wróć do wszystkich zabawek</span>
      </a>
    </nav>

    <!-- Main Product Grid: 2 columns on desktop, 1 column on mobile -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- LEFT COLUMN: Gallery & Photos (7 cols) -->
      <div class="lg:col-span-7 flex flex-col gap-4">
        <!-- Main Image Card -->
        <div class="relative bg-white rounded-2xl border border-[#E5E0D8] overflow-hidden shadow-sm">
          <div class="aspect-[4/5] sm:aspect-[1/1] w-full bg-stone-100 relative group cursor-zoom-in" id="main-image-container">
            <img
              id="active-toy-image"
              src={mainImage.src}
              alt={mainImage.alt}
              class="w-full h-full object-cover object-center transition-all duration-300"
            />

            <!-- Badge: AI Concept vs Real Photo -->
            {toy.mediaType === 'ai_concept' ? (
              <div class="absolute top-4 left-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold badge-ai shadow-md">
                <Icon name="sparkle" class="w-4 h-4 text-amber-300" />
                <span>Wizualizacja / Koncept</span>
              </div>
            ) : (
              <div class="absolute top-4 left-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-900/90 text-emerald-100 border border-emerald-500/30 shadow-md">
                <Icon name="check" class="w-4 h-4 text-emerald-300" />
                <span>Prawdziwe zdjęcie</span>
              </div>
            )}

            <!-- Click to enlarge hint -->
            <div class="absolute bottom-4 right-4 bg-black/60 backdrop-blur-sm text-white px-2.5 py-1 rounded text-xs opacity-0 group-hover:opacity-100 transition-opacity">
              Kliknij, aby powiększyć
            </div>
          </div>
        </div>

        <!-- Thumbnails Strip (if more than 1 image) -->
        {toy.images.length > 1 && (
          <div class="flex gap-3 overflow-x-auto pb-2">
            {toy.images.map((img, idx) => (
              <button
                type="button"
                data-img-src={img.src}
                data-img-alt={img.alt}
                class={`gallery-thumb flex-shrink-0 w-20 h-20 rounded-xl overflow-hidden border-2 transition-all ${
                  idx === 0 ? 'border-craft-accent shadow-sm' : 'border-[#E5E0D8] opacity-70 hover:opacity-100'
                }`}
              >
                <img src={img.src} alt={img.alt} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}

        <!-- Informational box for AI Concept -->
        {toy.mediaType === 'ai_concept' && (
          <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs sm:text-sm text-amber-950 flex items-start gap-3">
            <span class="text-amber-700 mt-0.5">
              <Icon name="sparkle" class="w-5 h-5" />
            </span>
            <div class="leading-relaxed">
              <strong class="font-semibold block text-amber-900">Zdjęcie poglądowe (Koncept AI)</strong>
              Prawdziwe fotografie gotowej zabawki pojawią się w tym miejscu zaraz po ukończeniu pierwszego fizycznego prototypu w pracowni. Możesz zamówić wykonanie tego projektu jako pierwszy!
            </div>
          </div>
        )}

        {toy.mediaType === 'real_photo' && (
          <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs sm:text-sm text-emerald-950 flex items-start gap-3">
            <span class="text-emerald-700 mt-0.5">
              <Icon name="check" class="w-5 h-5" />
            </span>
            <div class="leading-relaxed">
              <strong class="font-semibold block text-emerald-900">Gotowy egzemplarz z pracowni</strong>
              Zdjęcia przedstawiają rzeczywisty przedmiot wykonany ręcznie w pracowni.
            </div>
          </div>
        )}
      </div>

      <!-- RIGHT COLUMN: Details & Action (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-[#E5E0D8] shadow-sm">
          <!-- Category & Status -->
          <div class="flex items-center justify-between gap-3 mb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-craft-accent">
              {getCategoryLabel(toy.category)}
            </span>

            <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border ${statusConfig.badgeClass}`}>
              <span class={`w-2 h-2 rounded-full ${statusConfig.dotClass}`}></span>
              {statusConfig.label}
            </span>
          </div>

          <!-- Title -->
          <h1 class="text-2xl sm:text-3xl font-extrabold text-craft-dark tracking-tight">
            {toy.name}
          </h1>

          <!-- Price -->
          <div class="mt-4 flex items-baseline gap-2">
            {toy.pricePln !== null ? (
              <>
                <span class="text-3xl font-black text-craft-dark">{toy.pricePln}</span>
                <span class="text-sm font-semibold text-craft-muted">PLN (cena orientacyjna)</span>
              </>
            ) : (
              <span class="text-base font-semibold text-craft-muted italic">
                Cena do ustalenia po wykonaniu prototypu
              </span>
            )}
          </div>

          <!-- Description -->
          <div class="mt-6 pt-6 border-t border-[#F0ECE4]">
            <h2 class="text-xs font-bold text-craft-muted uppercase tracking-wider mb-2">Opis projektu</h2>
            <p class="text-sm sm:text-base text-craft-dark leading-relaxed">
              {toy.fullDescription}
            </p>
          </div>

          <!-- Technical Specs Table with Icons8 Style Icons -->
          <div class="mt-6 pt-6 border-t border-[#F0ECE4] space-y-3.5">
            <h2 class="text-xs font-bold text-craft-muted uppercase tracking-wider mb-3">Parametry wykonania</h2>
            
            <div class="flex items-center gap-3 text-sm">
              <span class="w-8 h-8 rounded-lg bg-stone-100 text-craft-dark flex items-center justify-center flex-shrink-0">
                <Icon name="ruler" class="w-4 h-4" />
              </span>
              <div>
                <span class="text-xs text-craft-muted block">Wysokość</span>
                <span class="font-semibold text-craft-dark">ok. {toy.specs.heightCm} cm</span>
              </div>
            </div>

            <div class="flex items-center gap-3 text-sm">
              <span class="w-8 h-8 rounded-lg bg-stone-100 text-craft-dark flex items-center justify-center flex-shrink-0">
                <Icon name="yarn" class="w-4 h-4" />
              </span>
              <div>
                <span class="text-xs text-craft-muted block">Materiały</span>
                <span class="font-semibold text-craft-dark">{toy.specs.materials.join(', ')}</span>
              </div>
            </div>

            <div class="flex items-center gap-3 text-sm">
              <span class="w-8 h-8 rounded-lg bg-stone-100 text-craft-dark flex items-center justify-center flex-shrink-0">
                <Icon name="clock" class="w-4 h-4" />
              </span>
              <div>
                <span class="text-xs text-craft-muted block">Czas realizacji / wysyłka</span>
                <span class="font-semibold text-craft-dark">{toy.specs.leadTime}</span>
              </div>
            </div>

            <div class="flex items-center gap-3 text-sm">
              <span class="w-8 h-8 rounded-lg bg-stone-100 text-craft-dark flex items-center justify-center flex-shrink-0">
                <Icon name="shield" class="w-4 h-4" />
              </span>
              <div>
                <span class="text-xs text-craft-muted block">Przeznaczenie</span>
                <span class="font-semibold text-craft-dark">{toy.specs.ageNote}</span>
              </div>
            </div>
          </div>

          <!-- Primary CTA Button -->
          <div class="mt-8 pt-6 border-t border-[#F0ECE4] flex flex-col gap-3">
            <a
              href={mailtoHref}
              class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-craft-accent text-white font-bold text-sm shadow-md hover:bg-craft-accent-hover transition-all text-center"
            >
              <Icon name="mail" class="w-4 h-4" />
              <span>Zapytaj o tę zabawkę</span>
            </a>

            <p class="text-[11px] text-center text-craft-muted">
              Kliknięcie otwiera wiadomość e-mail z uzupełnionym tematem i linkiem do tej zabawki.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4 cursor-zoom-out">
    <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[90vh] object-contain rounded-lg" />
  </div>

  <!-- Client-side script for gallery switching and lightbox -->
  <script>
    const activeImg = document.getElementById('active-toy-image') as HTMLImageElement;
    const thumbs = document.querySelectorAll('.gallery-thumb');
    const container = document.getElementById('main-image-container');
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;

    // Thumbnail switching
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const newSrc = thumb.getAttribute('data-img-src');
        const newAlt = thumb.getAttribute('data-img-alt');
        if (newSrc && activeImg) {
          activeImg.src = newSrc;
          if (newAlt) activeImg.alt = newAlt;
        }

        thumbs.forEach(t => {
          t.classList.remove('border-craft-accent', 'shadow-sm');
          t.classList.add('border-[#E5E0D8]', 'opacity-70');
        });
        thumb.classList.add('border-craft-accent', 'shadow-sm');
        thumb.classList.remove('border-[#E5E0D8]', 'opacity-70');
      });
    });

    // Lightbox open
    if (container && modal && modalImg) {
      container.addEventListener('click', () => {
        if (activeImg) {
          modalImg.src = activeImg.src;
          modalImg.alt = activeImg.alt;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      });

      modal.addEventListener('click', () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      });
    }
  </script>
</Layout>
